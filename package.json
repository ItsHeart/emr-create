{
  "name": "emr-create",
  "version": "1.0.3",
  "description": "基于 @form-create/naive-ui 的医疗表单增强组件库，提供开箱即用的自定义组件、表单配置预设和工具函数。",
  "type": "module",
  "main": "./dist/emr-create.umd.cjs",
  "module": "./dist/emr-create.js",
  "exports": {
    ".": {
      "import": "./dist/emr-create.js",
      "require": "./dist/emr-create.umd.cjs"
    },
    "./components": {
      "import": "./src/components/index.js"
    },
    "./utils": {
      "import": "./src/utils/index.js"
    },
    "./composables": {
      "import": "./src/composables/index.js"
    },
    "./dist/style.css": "./dist/emr-create.css"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "form-create",
    "naive-ui",
    "vue3",
    "medical",
    "emr",
    "form",
    "dynamic-form",
    "form-builder"
  ],
  "author": "ItsHeart",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/ItsHeart/emr-create"
  },
  "peerDependencies": {
    "@form-create/naive-ui": ">=3.1.0",
    "naive-ui": ">=2.34.0",
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@form-create/naive-ui": "^3.3.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "naive-ui": "^2.44.1",
    "vite": "^8.0.12",
    "vue": "^3.5.34"
  }
}
